---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PricingPage } from '../views/PricingPage'
import { SEO, SITE_URL } from '../data/site'
import { pricingProductJsonLd } from '../lib/seo'
import { getGame } from '../data/games'

const game = getGame('r6')
const jsonLdExtra = [
  pricingProductJsonLd(game?.status ?? 'Updating'),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: `${SITE_URL}/pricing` },
    ],
  },
]
---

<BaseLayout seo={SEO.pricing} jsonLdExtra={jsonLdExtra}>
  <PricingPage client:visible />
</BaseLayout>
